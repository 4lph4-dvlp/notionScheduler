# ==============================================================================
# Notion Scheduler 설정 템플릿 (.env.example)
#
# 이 파일을 복사하여 `.env`로 저장한 뒤 본인의 Notion 정보로 채워 넣으세요.
# 완성된 `.env` 파일은 API 토큰을 포함하므로 Git에 커밋하지 마세요.
# ==============================================================================

# 1. Notion 통합(Integration) 시크릿 토큰 (필수)
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. 대상 스케줄러 데이터베이스 식별자 (아래 3개 중 정확히 1개 설정)
# - 데이터베이스 ID (32자리 UUID, URL의 ?v= 앞부분): 가장 권장됨
NOTION_DATABASE_ID=

# - 또는 데이터 소스 ID
# NOTION_DATA_SOURCE_ID=

# - 또는 데이터베이스 제목 (유일해야 함)
# NOTION_DATABASE_NAME=Scheduler
